pipeline {
  agent any
  options { timestamps(); timeout(time: 15, unit: 'MINUTES') }
  environment { IMAGE = "gists-api:${env.BUILD_NUMBER}" }

  stages {
    stage('Test') {
      steps {
        dir('gists-api') {
          sh '''
            python3 -m venv .venv
            . .venv/bin/activate
            pip install -r requirements-dev.txt
            pytest -v
          '''
        }
      }
    }
    stage('Build image') {
      steps {
        dir('gists-api') { sh 'docker build -t $IMAGE .' }
      }
    }
    stage('Smoke test') {
      steps {
        sh '''
          docker run -d --name gists-smoke $IMAGE
          for i in $(seq 1 10); do
            if docker exec gists-smoke python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/_health')"; then
              echo "Health check OK"
              exit 0
            fi
            echo "Waiting for app... ($i)"
            sleep 2
          done
          docker logs gists-smoke
          exit 1
        '''
      }
    }
  }
  post {
    always { sh 'docker rm -f gists-smoke || true' }
  }
}